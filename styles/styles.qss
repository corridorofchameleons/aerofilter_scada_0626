* {
    font-family: "Consolas";
}

SCADAButton {
    width: 65px;
    border: 3px solid dimgray;
    padding: 5px;
    background-color: #B3E5FC;
    color: black;
    font-style: italic;
}

SCADAButton:hover {
    background-color: #90A4AE;
}

SCADAButton:pressed {
    background-color: #78909C;

    padding-top: 6px;
    padding-left: 6px;
    padding-bottom: 4px;
    padding-right: 4px;
}

#titleLabel, #valueLabel {
    border: 3px solid dimgray;
    color: black;
}

#titleLabel {
    background-color: #B0BEC5;
    font-style: italic;
    border-bottom: none;
    font-size: 11px;
}

#valueLabel {
    background-color: white;
    font-weight: bold;
    font-size: 14px;
}

QMainWindow {
    background-color: lightgray;
}

QGraphicsView {
    background-color: lightgray;
}

#fuelScheme {
    border: 4px solid gray;
}

#oilScheme {
    border: 4px solid #FFA000;
}